[SIZE=5][B][COLOR=#00b8d4]✦ Commands & Permissions[/COLOR][/B][/SIZE]

[B]Aliases:[/B] [FONT=Courier New]/armorswap[/FONT], [FONT=Courier New]/armor[/FONT], [FONT=Courier New]/as[/FONT]

[LIST]
[*][FONT=Courier New][B]/armorswap[/B][/FONT] — Toggle armor swapping on/off for yourself.
[COLOR=#555555]Permission:[/COLOR] [FONT=Courier New]armorswap.command.use[/FONT]

[*][FONT=Courier New][B]/armorswap head[/B][/FONT] — Swap the item in your main hand with your helmet slot.
[COLOR=#555555]Permission:[/COLOR] [FONT=Courier New]armorswap.command.head[/FONT]

[*][FONT=Courier New][B]/armorswap reload[/B][/FONT] — Reload [FONT=Courier New]config.yml[/FONT] without restarting.
[COLOR=#555555]Permission:[/COLOR] [FONT=Courier New]armorswap.command.reload[/FONT]

[*][FONT=Courier New][B]/armorswap help[/B][/FONT] — View the in-game command help menu.
[/LIST]

[B]Swap & Bypass Permissions (Configurable in [FONT=Courier New]config.yml[/FONT]):[/B]
[LIST]
[*][FONT=Courier New]armorswap.swap.mainhand[/FONT] — Allow right-click main-hand armor swapping.
[*][FONT=Courier New]armorswap.swap.armorstand[/FONT] — Allow Shift + Right-Click Armor Stand swapping.
[*][FONT=Courier New]armorswap.swap.itemframe[/FONT] — Allow Shift + Right-Click Item Frame swapping.
[*][FONT=Courier New]armorswap.bypass.enchantment[/FONT] — Allow bypassing Curse of Binding when swapping.
[/LIST]

[CENTER][COLOR=#cccccc]────────────────────────────────────────────────────────────────────────[/COLOR][/CENTER]

[SIZE=5][B][COLOR=#00b8d4]✦ Configuration (config.yml)[/COLOR][/B][/SIZE]
[SPOILER="Click to view default config.yml"]
[CODE]
# Enable/disable swapping item to armor stand
Armor_stand_swap: true
# Permission to use swapping items to armor stand
Armor_Stand_Swap_Permission: "armorswap.swap.armorstand"

# Enable/disable swapping item in main hand
Main_hand_swap: true
# Permission to use swapping items to main hand
Main_Hand_Swap_Permission: "armorswap.swap.mainhand"

# Enable/Disable swapping item to item frames
Item_frame_swap: true
# Permission to use swapping items to item frames
Item_Frame_Swap_Permission: "armorswap.swap.itemframe"

# Sound to play on swap (automatically falls back on legacy versions)
Sound: ITEM_ARMOR_EQUIP_TURTLE

# Bypass curse of binding globally
Bypass_enchantment: false

# Permission to bypass enchantment
Bypass_permission: "armorswap.bypass.enchantment"

#----------------------------------------------------------------------------------------------------------------
#                                                 Language
#----------------------------------------------------------------------------------------------------------------
# prefix
Prefix: "&bArmorSwap &7-"
# when player runs /armorswap
Enable: "&bArmor swap is now enabled for you"
Disable: "&bArmor swap is now disabled for you"
# on wrong usage
usageError: "&bUse &7/armorswap&b to enable armor swap"

# DO NOT TOUCH
Version: 1.5.9
[/CODE]
[/SPOILER]

